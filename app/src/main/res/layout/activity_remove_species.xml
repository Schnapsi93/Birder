<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/green_dark"
    android:padding="20dp">



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Remove Species"
        android:textSize="24sp"
        android:textColor="@color/cream"
        android:textStyle="bold"
        android:paddingTop="24dp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 species selected for removal"
        android:textSize="13sp"
        android:textColor="@color/green_light"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search species..."
        android:textColorHint="@color/green_light"
        android:textColor="@color/cream"
        android:backgroundTint="@color/green_mid"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:inputType="text"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnToggleName"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:textSize="13sp"
        android:textColor="@color/cream"
        android:backgroundTint="@color/green_mid"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnRemoveSelected"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🗑️  Remove Selected"
        android:textSize="16sp"
        android:textColor="@color/cream"
        android:backgroundTint="@color/green_mid"
        android:layout_marginTop="12dp"
        android:enabled="false" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/green_mid"
        android:dividerHeight="1dp" />



</LinearLayout>